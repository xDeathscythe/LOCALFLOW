{
  "manifest_version": 3,
  "name": "LocalFlow Meeting Detection",
  "version": "0.3.1",
  "description": "Offer LocalFlow transcription when a browser call connects. Sends call metadata only.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Connect LocalFlow", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*", "https://*.zoom.us/*", "https://web.whatsapp.com/*", "https://teams.microsoft.com/*", "https://teams.live.com/*", "https://teams.cloud.microsoft/*"],
      "js": ["detector.js"], "run_at": "document_start", "world": "MAIN"
    },
    {
      "matches": ["https://meet.google.com/*", "https://*.zoom.us/*", "https://web.whatsapp.com/*", "https://teams.microsoft.com/*", "https://teams.live.com/*", "https://teams.cloud.microsoft/*"],
      "js": ["content.js"], "run_at": "document_start"
    }
  ]
}
