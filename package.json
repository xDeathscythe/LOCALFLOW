{
  "name": "localflow",
  "version": "0.2.2",
  "private": true,
  "description": "Native Windows dictation, rich notes and Niwa agent with local PC inference.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop:dev": "tauri dev",
    "start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File start-localflow-desktop.ps1",
    "desktop": "npm run start",
    "build": "tsc && vite build",
    "build:release": "tsc && vite build --mode release",
    "runtime:native": "node scripts/stage-native-runtime.cjs",
    "desktop:build": "npm run runtime:native && tauri build --no-bundle",
    "dist:win": "npm run desktop:build && node scripts/package-windows.cjs",
    "dist:offline": "npm run desktop:build && node scripts/package-windows.cjs --zip",
    "test:native": "node tests/native-desktop.test.cjs src-tauri/target/release/localflow-desktop.exe",
    "test:native:inference": "npm run test:native -- --inference",
    "test:native:glass": "npm run test:native -- --glass",
    "test:workspace": "node tests/project-notes.test.mjs && node tests/undo-patch.test.mjs && node --experimental-strip-types tests/diff-parser.test.ts",
    "test:notes": "node --experimental-strip-types tests/notes-model.test.ts",
    "test:notes-editing": "node tests/notes-editing-store.test.mjs && node tests/page-tools.test.mjs && node tests/notes-pdf.test.cjs",
    "test:notes-databases": "node tests/notes-databases.test.mjs && node tests/database-pagination.test.mjs",
    "test:niwa": "node tests/niwa.test.mjs && node tests/conversation-recovery.test.mjs",
    "test:niwa-screen": "node tests/niwa-screen.test.mjs",
    "test:latency": "node tests/paste-text.test.cjs && node scripts/run-python.cjs tests/paste-input.test.py",
    "test:runtime": "node tests/transcription-worker.test.cjs",
    "test:performance": "node tests/performance-data.test.mjs",
    "test:duplex": "node tests/duplex-cleanup.test.cjs && node tests/duplex-session.test.cjs",
    "test:shortcuts": "node tests/shortcut-config.test.cjs && node scripts/run-python.cjs backend/hotkey_watcher.py --self-check && node scripts/run-python.cjs tests/mouse-shortcut.test.py",
    "test:cleanup": "node scripts/run-python.cjs tests/codex-cleanup.test.py",
    "test:cleanup-auth": "node tests/cleanup-auth.test.cjs",
    "test:stt": "node scripts/run-python.cjs tests/stt-models.test.py && node scripts/run-python.cjs tests/worker-config.test.py && node scripts/run-python.cjs tests/whisper-runtime.test.py",
    "test:tts": "node tests/tts-runtime.test.cjs && node tests/voice-output.test.cjs",
    "models:stage": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts\\stage-whisper-models.ps1",
    "runtime:stage": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts\\stage-transcription-runtime.ps1",
    "runtime:prerequisites": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/stage-vc-runtime.ps1",
    "agent:stage": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/stage-agent-runtime.ps1",
    "agent:verify": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/stage-agent-runtime.ps1 -VerifyOnly",
    "setup:python": "uv venv --python 3.11 .venv && uv pip install --python .venv\\Scripts\\python.exe -r backend\\requirements.txt",
    "setup:tts": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts\\install-tts.ps1",
    "verify:tts": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts\\install-tts.ps1 -VerifyOnly"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@mozilla/readability": "0.6.0",
    "@openai/codex": "0.159.0",
    "@tauri-apps/api": "2.12.1",
    "@tiptap/extension-details": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-mathematics": "^3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-task-item": "3.31.3",
    "@tiptap/extension-task-list": "3.31.3",
    "@tiptap/extension-text-align": "3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "jsep": "^1.4.0",
    "linkedom": "0.18.13",
    "playwright": "1.63.0",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "2.12.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "framer-motion": "^13.0.0",
    "lucide-react": "^0.555.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "overrides": {
    "esbuild": "0.27.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xDeathscythe/LOCALFLOW.git"
  },
  "bugs": {
    "url": "https://github.com/xDeathscythe/LOCALFLOW/issues"
  },
  "homepage": "https://github.com/xDeathscythe/LOCALFLOW#readme"
}
