LOCALFLOW_WHISPER_MODEL=large-v3
# Paths are resolved automatically inside the checkout or installed user-data directory.
# Override LOCALFLOW_WHISPER_DOWNLOAD_ROOT / LOCALFLOW_CUDA_BIN only when needed.
LOCALFLOW_WHISPER_LANGUAGE=sr
LOCALFLOW_CLEANUP_MODEL=gpt-5.6-terra
LOCALFLOW_CLEANUP_REASONING_EFFORT=medium
LOCALFLOW_CLEANUP_TIMEOUT=180
# CPU works without NVIDIA runtime DLLs. For CUDA, use cuda + float16.
LOCALFLOW_WHISPER_DEVICE=cpu
LOCALFLOW_WHISPER_COMPUTE_TYPE=int8
LOCALFLOW_WHISPER_BEAM_SIZE=1
LOCALFLOW_WHISPER_VAD_FILTER=true
LOCALFLOW_WHISPER_VAD_SPEECH_PAD_MS=400
LOCALFLOW_ALLOW_CPU_FALLBACK=false
LOCALFLOW_ONNX_STT_QUANTIZATION=int8
PYTHONIOENCODING=utf-8
HF_HUB_DISABLE_SYMLINKS_WARNING=1
LOCALFLOW_VOICE_OUTPUT_MODEL=piper
LOCALFLOW_VOICE_ROOT=runtime\tts
LOCALFLOW_PIPER_VOICE=en_US-kristin-medium
LOCALFLOW_XTTS_LANGUAGE=en
LOCALFLOW_OMNIVOICE_REFERENCE_TEXT=
LOCALFLOW_OMNIVOICE_LANGUAGE=Serbian
LOCALFLOW_OMNIVOICE_STEPS=32
LOCALFLOW_OMNIVOICE_GUIDANCE=2.0
LOCALFLOW_OMNIVOICE_DENOISE=true
LOCALFLOW_OMNIVOICE_SPEED=0.95
LOCALFLOW_OMNIVOICE_PREPROCESS_REFERENCE=true
LOCALFLOW_OMNIVOICE_POSTPROCESS_OUTPUT=true
