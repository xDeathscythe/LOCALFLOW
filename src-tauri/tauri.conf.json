{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalFlow",
  "version": "0.2.4",
  "identifier": "local.localflow.desktop",
  "build": {
    "beforeBuildCommand": "npm run build:release",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../runtime/release-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://localflow-asset.localhost localflow-asset:; media-src 'self' blob: data: http://localflow-asset.localhost; connect-src 'self' ipc: http://ipc.localhost http://localflow-asset.localhost https:; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "capabilities": [
        {
          "identifier": "desktop",
          "windows": [
            "main",
            "edge",
            "cleanup",
            "recording"
          ],
          "permissions": [
            "core:event:default",
            "core:window:allow-start-dragging",
            "core:window:allow-minimize",
            "core:window:allow-toggle-maximize",
            "core:window:allow-close"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../build/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
